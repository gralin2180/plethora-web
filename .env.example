# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Free chat / polish (pick one) ---
# OpenRouter free models: https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=openrouter/free

# Production public URL (also set NEXT_PUBLIC_SITE_URL the same for client auth emails)
PLETHORA_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production:
# PLETHORA_SITE_URL=https://plethora-ten.vercel.app
# NEXT_PUBLIC_SITE_URL=https://plethora-ten.vercel.app

# Or Groq free tier
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini (free-tier key from AI Studio)
# GEMINI_API_KEY=

# Premium models for Pro / try packs (defaults to OPENROUTER_API_KEY)
# PLETHORA_PAID_LLM_KEY=
# PLETHORA_PAID_LLM_MODEL=deepseek/deepseek-chat-v3-0324
# PLETHORA_PREMIUM_MODELS=deepseek/deepseek-chat-v3-0324,google/gemini-2.0-flash-001,openai/gpt-4o-mini

# Free-tier choke protection
# FREE_PLATFORM_RPM=90
# FREE_PLATFORM_CONCURRENT=40
# FREE_PLATFORM_DAILY_MAX=8000

# Stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...
# STRIPE_PRICE_HARDCORE=price_...
# STRIPE_PRICE_PACK_HOURLY=price_...
# STRIPE_PRICE_PACK_DAILY=price_...
# STRIPE_PRICE_PACK_WEEKLY=price_...
# SUPABASE_SERVICE_ROLE_KEY=
# PLETHORA_FAKE_BILLING=1

# Owner/dev chat bypass (production). Comma-separated. Local next dev is always unrestricted.
# PLETHORA_DEV_EMAILS=you@example.com
# ADMIN_EMAIL=you@example.com
# PLETHORA_DEV_USER_IDS=
# PLETHORA_DEV_UNRESTRICTED=1

# COBALT_API_URL=https://api.cobalt.tools/
