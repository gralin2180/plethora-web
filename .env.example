# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Free chat / polish (pick one) ---
# OpenRouter free models: https://openrouter.ai/models?q=free
# Get a key at https://openrouter.ai/keys (free credits / free models)
OPENROUTER_API_KEY=
# Optional override model id, e.g. openrouter/free or google/gemma-4-26b-a4b-it:free
OPENROUTER_FREE_MODEL=openrouter/free
# Production public URL (Vercel deployment — update when you attach plethora.com)
# Current: https://plethora-ten.vercel.app
PLETHORA_SITE_URL=http://localhost:3000
# For production on Vercel dashboard set:
# PLETHORA_SITE_URL=https://plethora-ten.vercel.app
# Later: PLETHORA_SITE_URL=https://plethora.com
# NEXT_PUBLIC_SITE_URL=https://plethora-ten.vercel.app

# Or Groq free tier: https://console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Or any OpenAI-compatible free endpoint
# PLETHORA_FREE_LLM_URL=https://openrouter.ai/api/v1
# PLETHORA_FREE_LLM_KEY=
# PLETHORA_FREE_LLM_MODEL=

# Optional Cobalt instance for instant YouTube resolve (defaults to api.cobalt.tools)
# COBALT_API_URL=https://api.cobalt.tools/
# COBALT_API_KEY=
# PLETHORA_PAID_LLM_URL=
# PLETHORA_PAID_LLM_KEY=
# PLETHORA_PAID_LLM_MODEL=
